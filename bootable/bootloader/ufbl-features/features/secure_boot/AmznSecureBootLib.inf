[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = AmznSecureBootLib
  FILE_GUID                      = 506a5e38-f13e-4d2b-b852-911d81b54d19
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = AmznSecureBootLib

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = ARM AARCH64
#

[Sources]
  image_verify.c
  image_verify_ltc.c

[BuildOptions.AARCH64]
	GCC:*_*_*_CC_FLAGS = -DUFBL_FEATURE_SECURE_BOOT -DUFBL_FEATURE_SECURE_BOOT_LTC -DLTC_SOURCE -DLTC_NO_FILE -DUSE_LTM -DLTM_DESC -DLTC_CLEAN_STACK -D_WCHAR_T -ffunction-sections -fdata-sections -std=c99
	#GCC:*_*_*_CC_FLAGS = -DUFBL_FEATURE_SECURE_BOOT -DUFBL_FEATURE_SECURE_BOOT_LTC -DLTC_SOURCE -DLTC_NO_FILE -DUSE_LTM -DLTM_DESC -DLTC_CLEAN_STACK -D_WCHAR_T -ffunction-sections -fdata-sections -std=c99

[Packages]
  StdLib/StdLib.dec
  MdePkg/MdePkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  ufbl-features/ufbl-features.dec
  IdmePlatformPkg/IdmePlatformPkg.dec

[LibraryClasses]
  LibC
  LibStdio
  MemoryAllocationLib
  LibtomcryptLib
