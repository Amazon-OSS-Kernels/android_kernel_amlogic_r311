#
# Remote control drivers
#
menuconfig AMLOGIC_REMOTE
	bool "GX Remotes"
	default n
	help
	  Say Y here, and a list of supported remote controls will be displayed.
	  This option doesn't affect the kernel.

	  If unsure, say Y.

if AMLOGIC_REMOTE

config MESON_REMOTE
	tristate "GX IR remote control support"
	default n
	help
	  Say Y here if you want to use the Meson IR remote control.



config MESON_REMOTE_LEARN
	tristate "GX IR learn support"
	depends on MESON_REMOTE
	default n
	help
	  Say Y here if you want to use the Meson IR learning.

config AM_WOL
	tristate "WOL support"
	default n
	help
	  Say Y here if you want to use WOL
endif # AMLOGIC_REMOTE
